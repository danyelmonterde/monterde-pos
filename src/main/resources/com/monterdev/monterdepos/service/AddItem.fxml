<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="980.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.monterdev.monterdepos.service.AddItemService">
  <children>
    <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="375.0" prefWidth="976.0" VBox.vgrow="ALWAYS">
      <children>
            <TextField fx:id="itemCode" layoutX="14.0" layoutY="26.0" onKeyReleased="#searchProductCode" prefHeight="38.0" prefWidth="220.0" promptText="Scan or Type Barcode">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="itemName" disable="true" layoutX="14.0" layoutY="100.0" prefHeight="38.0" prefWidth="467.0" promptText="Input Item Name">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="itemQuantity" disable="true" layoutX="14.0" layoutY="169.0" onKeyTyped="#quantityOnly" prefHeight="38.0" prefWidth="220.0" promptText="Input Quantity as PCS">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="itemLowStock" disable="true" layoutX="14.0" layoutY="237.0" prefHeight="38.0" prefWidth="220.0" promptText="Low Stock Notification">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="itemInStock" disable="true" layoutX="14.0" layoutY="309.0" prefHeight="38.0" prefWidth="220.0" promptText="Item in Stock">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="itemAverageCost" disable="true" layoutX="260.0" layoutY="24.0" prefHeight="38.0" prefWidth="220.0" promptText="Average Cost">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <RadioButton fx:id="isDiscountable" disable="true" layoutX="500.0" layoutY="111.0" mnemonicParsing="false" style="-fx-font-size: 14;" text="DISCOUNTABLE" />
            <TextField fx:id="itemSupplierName" disable="true" layoutX="260.0" layoutY="237.0" prefHeight="38.0" prefWidth="220.0" promptText="Input Supplier Name">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <DatePicker fx:id="dateBoughtFromSupplier" disable="true" layoutX="260.0" layoutY="309.0" prefHeight="38.0" prefWidth="220.0" promptText="Date Bought" />
            <Label layoutX="14.0" layoutY="6.0" style="-fx-font-size: 14;" text="PRODUCT CODE / BARCODE" />
            <Label layoutX="14.0" layoutY="83.0" style="-fx-font-size: 14;" text="ITEM NAME" />
            <Label layoutX="14.0" layoutY="152.0" style="-fx-font-size: 14;" text="QUANTITY" />
            <Label layoutX="14.0" layoutY="220.0" style="-fx-font-size: 14;" text="LOW STOCK" />
            <Label layoutX="14.0" layoutY="287.0" style="-fx-font-size: 14;" text="IN STOCK" />
            <Label layoutX="260.0" layoutY="6.0" style="-fx-font-size: 14;" text="SELLING PRICE" />
            <ComboBox fx:id="itemCategory" disable="true" layoutX="260.0" layoutY="169.0" prefHeight="38.0" prefWidth="220.0" />
            <Label layoutX="260.0" layoutY="152.0" style="-fx-font-size: 14;" text="CATEGORY" />
            <TextField fx:id="itemSupplierLocation" disable="true" layoutX="745.0" layoutY="25.0" prefHeight="38.0" prefWidth="220.0" promptText="Input Supplier Location">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <Label layoutX="745.0" layoutY="6.0" style="-fx-font-size: 14;" text="SUPPLIER LOCATION" />
            <Label layoutX="260.0" layoutY="220.0" style="-fx-font-size: 14;" text="SUPPLIER NAME" />
            <Label layoutX="263.0" layoutY="287.0" style="-fx-font-size: 14;" text="DATE BOUGHT FROM SUPPLIER" />
            <Button fx:id="btnAddItem" layoutX="745.0" layoutY="103.0" mnemonicParsing="false" onAction="#addItem" prefHeight="38.0" prefWidth="220.0" style="-fx-font-size: 14;" text="ADD ITEM" visible="false" />
            <Button fx:id="btnUpdateItem" layoutX="745.0" layoutY="164.0" mnemonicParsing="false" onAction="#updateItem" prefHeight="38.0" prefWidth="220.0" style="-fx-font-size: 14;" text="UPDATE ITEM" visible="false" />
            <Button fx:id="btnDeleteItem" layoutX="745.0" layoutY="232.0" mnemonicParsing="false" onAction="#deleteItem" prefHeight="38.0" prefWidth="220.0" style="-fx-font-size: 14;" text="DELETE ITEM" visible="false" />
            <Button fx:id="btnCancel" layoutX="745.0" layoutY="299.0" mnemonicParsing="false" onAction="#cancel" prefHeight="38.0" prefWidth="220.0" style="-fx-font-size: 14;" text="CANCEL" visible="false" />
            <TextField fx:id="originalPrice" disable="true" layoutX="500.0" layoutY="24.0" prefHeight="38.0" prefWidth="220.0" promptText="Original Price">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <Label layoutX="500.0" layoutY="6.0" style="-fx-font-size: 14;" text="ORIGINAL PRICE" />
      </children>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
    </AnchorPane>
  </children>
</VBox>
