<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.monterdev.monterdepos.service.AddItemService">
  <children>
    <MenuBar VBox.vgrow="NEVER">
      <menus>
        <Menu mnemonicParsing="false" text="File">
          <items>
            <MenuItem mnemonicParsing="false" text="New" />
            <MenuItem mnemonicParsing="false" text="Open…" />
            <Menu mnemonicParsing="false" text="Open Recent" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Close" />
            <MenuItem mnemonicParsing="false" text="Save" />
            <MenuItem mnemonicParsing="false" text="Save As…" />
            <MenuItem mnemonicParsing="false" text="Revert" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Preferences…" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Quit" />
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Edit">
          <items>
            <MenuItem mnemonicParsing="false" text="Undo" />
            <MenuItem mnemonicParsing="false" text="Redo" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Cut" />
            <MenuItem mnemonicParsing="false" text="Copy" />
            <MenuItem mnemonicParsing="false" text="Paste" />
            <MenuItem mnemonicParsing="false" text="Delete" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Select All" />
            <MenuItem mnemonicParsing="false" text="Unselect All" />
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Help">
          <items>
            <MenuItem mnemonicParsing="false" text="About MyHelloApp" />
          </items>
        </Menu>
      </menus>
    </MenuBar>
    <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="375.0" prefWidth="782.0" VBox.vgrow="ALWAYS">
      <children>
            <TextField fx:id="itemCode" layoutX="14.0" layoutY="26.0" prefHeight="38.0" prefWidth="220.0" promptText="Scan or Type Barcode">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="itemName" layoutX="14.0" layoutY="100.0" prefHeight="38.0" prefWidth="220.0" promptText="Input Item Name">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="itemQuantity" layoutX="14.0" layoutY="169.0" prefHeight="38.0" prefWidth="220.0" promptText="Input Quantity as PCS">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="itemLowStock" layoutX="14.0" layoutY="237.0" prefHeight="38.0" prefWidth="220.0" promptText="Low Stock Notification">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="itemInStock" layoutX="14.0" layoutY="309.0" prefHeight="38.0" prefWidth="220.0" promptText="Item in Stock">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="itemAverageCost" layoutX="260.0" layoutY="24.0" prefHeight="38.0" prefWidth="220.0" promptText="Average Cost">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <RadioButton fx:id="isDiscountable" layoutX="260.0" layoutY="111.0" mnemonicParsing="false" text="DISCOUNTABLE" />
            <TextField fx:id="itemSupplierName" layoutX="260.0" layoutY="237.0" prefHeight="38.0" prefWidth="220.0" promptText="Input Supplier Name">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <DatePicker fx:id="dateBoughtFromSupplier" layoutX="260.0" layoutY="309.0" prefHeight="38.0" prefWidth="220.0" promptText="Date Bought" />
            <Label layoutX="14.0" layoutY="6.0" text="PRODUCT CODE / BARCODE" />
            <Label layoutX="14.0" layoutY="83.0" text="ITEM NAME" />
            <Label layoutX="14.0" layoutY="152.0" text="QUANTITY" />
            <Label layoutX="14.0" layoutY="220.0" text="LOW STOCK" />
            <Label layoutX="14.0" layoutY="287.0" text="IN STOCK" />
            <Label layoutX="260.0" layoutY="6.0" text="SELLING PRICE" />
            <ComboBox fx:id="itemCategory" layoutX="260.0" layoutY="169.0" prefHeight="38.0" prefWidth="220.0" />
            <Label layoutX="260.0" layoutY="152.0" text="CATEGORY" />
            <TextField fx:id="itemSupplierLocation" layoutX="511.0" layoutY="24.0" prefHeight="38.0" prefWidth="220.0" promptText="Input Supplier Location">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <Label layoutX="511.0" layoutY="6.0" text="SUPPLIER LOCATION" />
            <Label layoutX="260.0" layoutY="220.0" text="SUPPLIER NAME" />
            <Label layoutX="263.0" layoutY="287.0" text="DATE BOUGHT FROM SUPPLIER" />
            <Button fx:id="btnAddItem" layoutX="511.0" layoutY="101.0" mnemonicParsing="false" onAction="#addItem" prefHeight="38.0" prefWidth="169.0" text="ADD ITEM" />
            <Button fx:id="btnUpdateItem" layoutX="511.0" layoutY="169.0" mnemonicParsing="false" onAction="#updateItem" prefHeight="38.0" prefWidth="169.0" text="UPDATE ITEM" />
            <Button fx:id="btnDeleteItem" layoutX="511.0" layoutY="237.0" mnemonicParsing="false" onAction="#deleteItem" prefHeight="38.0" prefWidth="169.0" text="DELETE ITEM" />
            <Button fx:id="btnCancel" layoutX="511.0" layoutY="304.0" mnemonicParsing="false" onAction="#cancel" prefHeight="38.0" prefWidth="169.0" text="CANCEL" />
      </children>
    </AnchorPane>
  </children>
</VBox>
